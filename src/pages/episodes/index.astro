---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";

const episodes = (await getCollection("episodes")).sort(
  (a, b) => b.data.episode_number - a.data.episode_number
);

// Collect all unique topics
const allTopics = [...new Set(episodes.flatMap((e) => e.data.topics))].sort();
---

<Layout
  title="All episodes — SpeakForWater"
  description={`Browse all ${episodes.length} episodes of SpeakForWater, the daily AI-narrated water research podcast.`}
>
  <section class="archive-head">
    <div class="container">
      <div class="head-row">
        <div>
          <span class="eyebrow">Archive</span>
          <h1>All episodes</h1>
        </div>
        <p class="meta">
          <strong>{episodes.length}</strong> episodes
          <span class="dot">·</span>
          <strong>{allTopics.length}</strong> topics
        </p>
      </div>
    </div>
  </section>

  <section class="archive-body">
    <div class="container archive-layout">
      {allTopics.length > 0 && (
        <aside class="filter-rail">
          <span class="rail-title">Filter by topic</span>
          <div class="filters" id="filters">
            <button class="filter active" data-filter="all">All episodes</button>
            {allTopics.map((t) => (
              <button class="filter" data-filter={t}>{t}</button>
            ))}
          </div>
        </aside>
      )}

      <div class="episode-grid" id="episode-grid">
        {episodes.map((ep) => (
          <div class="card-wrap" data-topics={ep.data.topics.join(",")}>
            <EpisodeCard
              href={`/episodes/${ep.slug}`}
              number={ep.data.episode_number}
              title={ep.data.title}
              date={ep.data.pub_date}
              duration={ep.data.duration}
              audioUrl={ep.data.audio_url}
              cover={ep.data.cover}
              journal={ep.data.paper.journal}
              topics={ep.data.topics}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Compact header ──────────────────────────────── */
  .archive-head {
    padding: 40px 0 22px;
    border-bottom: 1px solid var(--c-border);
  }

  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .archive-head h1 {
    margin-top: 8px;
  }

  .meta {
    font-size: 0.95rem;
    color: var(--c-ink-muted);
    white-space: nowrap;
  }

  .meta strong {
    color: var(--c-ink);
    font-weight: 700;
  }

  .meta .dot {
    margin: 0 6px;
    opacity: 0.5;
  }

  /* ── Two-column body: filter rail + grid ─────────── */
  .archive-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    padding: 32px 0 80px;
    align-items: start;
  }

  .filter-rail {
    position: sticky;
    top: 88px;
  }

  .rail-title {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 700;
    color: var(--c-ink-muted);
    margin-bottom: 10px;
    padding-left: 12px;
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .filter {
    width: 100%;
    text-align: left;
    padding: 8px 12px;
    background: transparent;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--c-ink-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.15s ease;
  }

  .filter:hover {
    background: var(--c-bg-card);
    color: var(--c-brand);
  }

  .filter.active {
    background: var(--c-brand);
    color: white;
  }

  .episode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 18px;
  }

  .card-wrap.hidden { display: none; }

  /* ── Mobile: rail collapses to horizontal pills ──── */
  @media (max-width: 880px) {
    .archive-layout {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-top: 24px;
    }

    .filter-rail {
      position: static;
    }

    .rail-title {
      padding-left: 0;
    }

    .filters {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }

    .filter {
      width: auto;
      border: 1px solid var(--c-border-strong);
      border-radius: var(--radius-pill);
      padding: 6px 14px;
      font-size: 0.82rem;
    }

    .filter:hover {
      border-color: var(--c-brand);
    }
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".filter");
  const cards = document.querySelectorAll<HTMLDivElement>(".card-wrap");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      filters.forEach((b) => b.classList.toggle("active", b === btn));

      cards.forEach((c) => {
        if (filter === "all") {
          c.classList.remove("hidden");
        } else {
          const topics = (c.dataset.topics || "").split(",");
          c.classList.toggle("hidden", !topics.includes(filter));
        }
      });
    });
  });
</script>
